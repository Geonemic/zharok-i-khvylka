{
  // Cloudflare Worker: віддає зібрану гру (apps/web/dist) і кімнати для онлайн-гри.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "zharok-i-khvylka",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // безкоштовний план підтримує лише Durable Objects зі сховищем SQLite
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
