{
  "name": "zharok-i-khvylka",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w @zh/web",
    "build": "npm run build -w @zh/web",
    "deploy": "npm run build && npm run deploy -w @zh/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/server/tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
